{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/word-sense.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/teacher-result.html",
      "destination": "/public/teacher-result.html"
    },
    {
      "source": "/unit-report.html",
      "destination": "/public/unit-report.html"
    }
  ]
}
